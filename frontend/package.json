{
  "name": "astrophoto-frontend",
  "private": true,
  "packageManager": "pnpm@11.13.1",
  "devDependencies": {
    "@comfyorg/comfyui-frontend-types": "1.59.1",
    "@eslint/js": "9.27.0",
    "@tailwindcss/vite": "^4.3.2",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitejs/plugin-vue-jsx": "5.1.6",
    "@vitest/browser-playwright": "5.1.1",
    "@vue/test-utils": "2.6.0",
    "eslint": "9.27.0",
    "eslint-plugin-vue": "^10.7.0",
    "globals": "16.1.0",
    "playwright": "1.65.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "5.1.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "3.3.14"
  },
  "scripts": {
    "build": "vite build",
    "test": "vite build && vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "cd .. && eslint --config frontend/eslint.config.mjs frontend/src extension --max-warnings 0",
    "watch": "vite build --watch",
    "test:host": "node tests/host/host-runtime.mjs",
    "test:equipment-host": "node tests/host/equipment-host.mjs",
    "test:storage-host": "node tests/host/storage-host.mjs",
    "test:siril-host": "node tests/host/siril-host.mjs",
    "check:build": "node scripts/check-build.mjs",
    "check:proxy": "node scripts/check-proxy.mjs"
  },
  "dependencies": {
    "@vueuse/core": "14.4.0",
    "@vueuse/integrations": "14.4.0",
    "clsx": "2.1.1",
    "cva": "1.0.0-beta.4",
    "fuse.js": "7.0.0",
    "reka-ui": "2.11.0",
    "tailwind-merge": "2.6.1",
    "tailwindcss": "^4.3.2",
    "vue": "3.5.42",
    "vue-i18n": "^11.4.23"
  }
}

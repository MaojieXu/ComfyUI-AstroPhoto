# Built bundles contain upstream dependency comments; check source whitespace,
# not formatting preserved by Vite inside generated third-party code.
js/** linguist-generated=true -whitespace

# Preserve handoff evidence and skill manifests byte for byte.
.agents/archive/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
.agents/handoff/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
.agents/features/archive/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
.agents/features/archive/**/evidence/*.txt -whitespace
.agents/notes/** -text whitespace=trailing-space,space-before-tab,cr-at-eol
.agents/skills/astrophoto-sop/** -text

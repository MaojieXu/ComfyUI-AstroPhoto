+    mount_path = kernel.GetVolumePathNameW
+    mount_path.argtypes = (wintypes.LPCWSTR, wintypes.LPWSTR, wintypes.DWORD)
+    mount_name = kernel.GetVolumeNameForVolumeMountPointW
+    mount_name.argtypes = mount_path.argtypes

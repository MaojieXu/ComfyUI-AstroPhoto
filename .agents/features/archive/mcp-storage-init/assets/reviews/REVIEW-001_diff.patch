+def test_concurrent_init_converges_and_retry_preserves_completed_steps(storage, monkeypatch):
+    migration_dir = storage.root / "runtime/migrations"
+    outputs = storage.root / "workspace/outputs"
+    outputs.rmdir()
+    migration_dir.rmdir()
+    original_mkdir = Path.mkdir
+
+    def fail_migrations(path, *args, **kwargs):
+        if path == migration_dir:
+            raise PermissionError("injected mkdir failure")
+        return original_mkdir(path, *args, **kwargs)
+
+    with monkeypatch.context() as patch:
+        patch.setattr(Path, "mkdir", fail_migrations)
+        with pytest.raises(PermissionError):
+            storage.ensure_layout()
+    assert outputs.is_dir() and not migration_dir.exists()
+    barrier = Barrier(2)
+
+    def invoke():
+        barrier.wait(timeout=5)
+        try:
+            return storage.ensure_layout()["created"]
+        except StorageError as exc:
+            assert exc.code == "STORAGE_BUSY"
+            return []
+
+    with ThreadPoolExecutor(2) as pool:
+        futures = [pool.submit(invoke) for _ in range(2)]
+    assert sorted(key for f in futures for key in f.result()) == ["runtime/migrations/"]
+    assert storage.ensure_layout()["created"] == []
+
